package-as: QuestTriage

# Development files stay out of the zip players download.
ignore:
  - tests.lua
  - run-tests.sh
  - pics
  - CURSEFORGE.md
  - README.md
  - media/logo-512.png
  - media/logo-400.png
  - media/social-preview.png
  - docs
  - tools
  - .github
  - .gitignore
  - .gitattributes
  - SECURITY.md

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
